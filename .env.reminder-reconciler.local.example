# Copy to .env.reminder-reconciler.local for the isolated run-once reconciler only.
# Never load this file into the HTTP API or the reminder sender. Do not commit the copy.
NODE_ENV=development

# Restricted gym_app runtime connection; never use migration or owner credentials.
DATABASE_URL="postgresql://gym_app:replace-with-local-password@localhost:5432/gym_dev?sslmode=verify-full"
DATABASE_POOL_MAX=2
DATABASE_CONNECTION_TIMEOUT_MS=10000

# Separate explicit gates; this process only reads provider delivery status and updates the outbox.
MEMBER_REMINDER_SCHEDULER_ENABLED=true
MEMBER_REMINDER_RECONCILIATION_ENABLED=true
MEMBER_REMINDER_FROM_EMAIL=reminders@notify.example.invalid

# Create a dedicated full-access Resend key; GET /emails does not support sending-only keys.
# Scope the secret to this process and rotate it independently from the sender key.
RESEND_REMINDER_RECONCILER_API_KEY=re_replace_with_dedicated_full_access_key
