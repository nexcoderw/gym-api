{
	"name": "@nexcoderw/gym-api",
	"version": "0.1.0",
	"description": "Shared multi-tenant API for NEXCODE Gym Management SaaS",
	"author": "NEXCODE LTD",
	"private": true,
	"type": "module",
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main.js",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.cjs --runInBand",
		"test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.cjs --selectProjects unit --runInBand",
		"test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.cjs --selectProjects integration --runInBand",
		"test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.cjs --selectProjects e2e --runInBand",
		"test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.cjs --coverage --runInBand",
		"bootstrap:platform-owner:init": "node dist/cli/platform-owner-bootstrap.js initialize",
		"bootstrap:platform-owner:activate": "node dist/cli/platform-owner-bootstrap.js activate"
	},
	"engines": {
		"node": "^20.19.0 || ^22.12.0 || >=24.0.0",
		"npm": ">=10.0.0"
	},
	"dependencies": {
		"@nexcoderw/gym-db": "0.1.1",
		"@nestjs/common": "^11.1.6",
		"@nestjs/config": "^4.0.2",
		"@nestjs/core": "^11.1.6",
		"@nestjs/platform-express": "^11.1.6",
		"@nestjs/swagger": "^11.2.1",
		"@nestjs/throttler": "^6.4.0",
		"argon2": "^0.44.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.2",
		"cookie": "^1.0.2",
		"helmet": "^8.1.0",
		"otpauth": "^9.5.2",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2"
	},
	"devDependencies": {
		"@eslint/js": "^9.18.0",
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.1.6",
		"@types/express": "^5.0.0",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.10.7",
		"@types/supertest": "^6.0.2",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-prettier": "^5.2.2",
		"globals": "^16.0.0",
		"jest": "^29.7.0",
		"prettier": "^3.4.2",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-jest": "^29.4.5",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.20.0"
	}
}
