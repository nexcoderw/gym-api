# Bootstrap integration-test process. Loaded only by npm run test:bootstrap:postgres.
NODE_ENV=test
PLATFORM_OWNER_BOOTSTRAP_ENABLED=false
BOOTSTRAP_POSTGRES_TESTS=1

# Disposable, independently marked bootstrap-test database. Do not override DATABASE_URL here.
BOOTSTRAP_TEST_DATABASE_URL="postgresql://gym_bootstrap_test:replace-with-test-password@localhost:5432/gym_bootstrap_test?sslmode=verify-full"
# Generate the marker UUID with: uuidgen | tr '[:upper:]' '[:lower:]'
BOOTSTRAP_TEST_DATABASE_MARKER=nexcode-gym:disposable-bootstrap-test:00000000-0000-4000-8000-000000000000
