# Loaded only by npm run test:bootstrap:postgres, after .env.local for target comparisons.
# This explicit test command authorizes fixture writes on the independently marked database.
NODE_ENV=test
PLATFORM_OWNER_BOOTSTRAP_ENABLED=false
BOOTSTRAP_POSTGRES_TESTS=1
BOOTSTRAP_TEST_DATABASE_URL="postgresql://gym_bootstrap_test:replace-me@localhost:5432/gym_bootstrap_test?sslmode=verify-full"
BOOTSTRAP_TEST_DATABASE_MARKER=nexcode-gym:disposable-bootstrap-test:replace-with-uuid-v4

# Do not override DATABASE_URL or other reference database URLs in this file.
