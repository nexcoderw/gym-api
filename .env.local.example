NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:4000,http://localhost:4001
SWAGGER_ENABLED=true
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100
# Development branch / gym_dev. Runtime role only; never an owner or test role.
DATABASE_URL=postgresql://gym_app:replace-me@localhost:5432/gym_dev?sslmode=verify-full
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000

# Development-only platform authentication values. Use disposable identities only.
PLATFORM_ADMIN_ORIGIN=http://localhost:4000
PLATFORM_AUTH_COOKIE_SECURE=false
PLATFORM_AUTH_DUMMY_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=1$replace-with-salt$replace-with-hash'
PLATFORM_AUTH_TOKEN_PEPPER=replace-with-canonical-base64-encoded-32-byte-key
PLATFORM_AUTH_SESSION_TTL_SECONDS=28800
PLATFORM_AUTH_IDLE_TTL_SECONDS=1800
PLATFORM_AUTH_MFA_CHALLENGE_TTL_SECONDS=300
PLATFORM_AUTH_MFA_MAX_ATTEMPTS=5
PLATFORM_AUTH_LOGIN_ATTEMPT_WINDOW_MS=900000
PLATFORM_AUTH_LOGIN_ATTEMPT_LIMIT=5
PLATFORM_AUTH_SINGLE_INSTANCE=true
# Opt-in fallback: mailbox access is weaker than authenticator MFA.
PLATFORM_AUTH_EMAIL_OTP_ENABLED=false
RESEND_API_KEY=
# Bare address on your Resend-verified domain; never use an arbitrary recipient as sender.
RESEND_FROM_EMAIL=
PLATFORM_TOTP_KEYRING=local-v1=replace-with-canonical-base64-encoded-32-byte-key
PLATFORM_TOTP_ACTIVE_KEY_ID=local-v1

# Organization Portal authentication. Use independent generated keys for each pepper.
ORGANIZATION_PORTAL_ORIGIN=http://localhost:4001
OWNER_AUTH_COOKIE_SECURE=false
OWNER_AUTH_TOKEN_PEPPER=replace-with-canonical-base64-encoded-32-byte-key
OWNER_ENROLLMENT_TOKEN_PEPPER=replace-with-a-different-canonical-base64-encoded-32-byte-key
OWNER_AUTH_SESSION_TTL_SECONDS=28800
OWNER_AUTH_IDLE_TTL_SECONDS=1800
OWNER_ENROLLMENT_CHALLENGE_TTL_SECONDS=600
OWNER_AUTH_LOGIN_ATTEMPT_WINDOW_MS=900000
OWNER_AUTH_LOGIN_ATTEMPT_LIMIT=5

# Keep disabled during normal API operation. Operator settings use .env.bootstrap.local.
PLATFORM_OWNER_BOOTSTRAP_ENABLED=false

# Step 21: keep OFF until the forward repair, grants, sender and real acceptance page are reviewed.
OWNER_INVITATION_DELIVERY_ENABLED=false
OWNER_INVITATION_DELIVERY_DATABASE_APPROVED=false
OWNER_INVITATION_ACCEPTANCE_REVIEW_ID=
OWNER_INVITATION_ACCEPTANCE_ORIGIN=
OWNER_INVITATION_ACCEPTANCE_PATH=/invitations/accept
OWNER_INVITATION_TOKEN_HMAC_SECRET=
# Comma-separated key-id=canonical-base64-32-byte-key; independent of platform authentication keys.
OWNER_INVITATION_ENCRYPTION_KEYRING=
OWNER_INVITATION_ENCRYPTION_ACTIVE_KEY_ID=
OWNER_INVITATION_EXPIRY_SECONDS=86400
OWNER_INVITATION_DELIVERY_LEASE_SECONDS=60
OWNER_INVITATION_DELIVERY_MAX_ATTEMPTS=3
OWNER_INVITATION_DELIVERY_CONCURRENCY=1
# Set a unique stable deployment identity only in the manually started worker environment.
OWNER_INVITATION_WORKER_ID=

# Disposable PostgreSQL test settings belong only in .env.bootstrap-test.local.
