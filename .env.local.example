# Local API process and browser origins. These values expose only local development services.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:4000,http://localhost:4001
SWAGGER_ENABLED=true

# Global API rate limiting. The window is milliseconds and the limit is requests per window.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100

# Development runtime database. Use the restricted gym_app role, never an owner or migration role.
DATABASE_URL="postgresql://gym_app:replace-with-local-password@localhost:5432/gym_dev?sslmode=verify-full"
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000

# Platform administrator session and login policy for the admin app on port 4000.
PLATFORM_ADMIN_ORIGIN=http://localhost:4000
PLATFORM_AUTH_COOKIE_SECURE=false
# Generate with: node --input-type=module -e "import argon2 from 'argon2'; console.log(await argon2.hash('replace-with-a-random-dummy-password'))"
PLATFORM_AUTH_DUMMY_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=1$replace-with-generated-salt$replace-with-generated-hash'
# Generate with: openssl rand -base64 32 | tr -d '\n'
PLATFORM_AUTH_TOKEN_PEPPER=replace-with-canonical-base64-32-byte-key
PLATFORM_AUTH_SESSION_TTL_SECONDS=28800
PLATFORM_AUTH_IDLE_TTL_SECONDS=1800
PLATFORM_AUTH_LOGIN_ATTEMPT_WINDOW_MS=900000
PLATFORM_AUTH_LOGIN_ATTEMPT_LIMIT=5
PLATFORM_AUTH_SINGLE_INSTANCE=true

# Platform MFA policy. Email OTP is an opt-in fallback; authenticator MFA remains preferred.
PLATFORM_AUTH_MFA_CHALLENGE_TTL_SECONDS=300
PLATFORM_AUTH_MFA_MAX_ATTEMPTS=5
PLATFORM_AUTH_EMAIL_OTP_ENABLED=false
# Generate with: openssl rand -base64 32 | tr -d '\n'
PLATFORM_TOTP_KEYRING=local-v1=replace-with-canonical-base64-32-byte-key
PLATFORM_TOTP_ACTIVE_KEY_ID=local-v1

# Resend transactional email. Create the API key in Resend; never generate or commit a real key here.
# The current API uses this one verified sender for MFA and owner invitations.
RESEND_API_KEY=re_example_not_a_real_key
RESEND_FROM_EMAIL=onboarding@notify.example.invalid

# Organization portal authentication for the manager app on port 4001.
# Generate each pepper independently with: openssl rand -base64 32 | tr -d '\n'
ORGANIZATION_PORTAL_ORIGIN=http://localhost:4001
OWNER_AUTH_COOKIE_SECURE=false
OWNER_AUTH_TOKEN_PEPPER=replace-with-independent-canonical-base64-32-byte-key
OWNER_ENROLLMENT_TOKEN_PEPPER=replace-with-different-canonical-base64-32-byte-key
OWNER_AUTH_SESSION_TTL_SECONDS=28800
OWNER_AUTH_IDLE_TTL_SECONDS=1800
OWNER_AUTH_LOGIN_ATTEMPT_WINDOW_MS=900000
OWNER_AUTH_LOGIN_ATTEMPT_LIMIT=5
OWNER_ENROLLMENT_CHALLENGE_TTL_SECONDS=600

# Interactive platform-owner bootstrap stays disabled during normal API operation.
# Its operator-only connection and target guards belong in .env.bootstrap.local.
PLATFORM_OWNER_BOOTSTRAP_ENABLED=false

# Owner invitation delivery release gates, acceptance path, cryptography and worker limits.
# Keep both gates false until database grants, sender and the public acceptance page are reviewed.
OWNER_INVITATION_DELIVERY_ENABLED=false
OWNER_INVITATION_DELIVERY_DATABASE_APPROVED=false
# Generate with: uuidgen | tr '[:upper:]' '[:lower:]'
OWNER_INVITATION_ACCEPTANCE_REVIEW_ID=00000000-0000-4000-8000-000000000000
OWNER_INVITATION_ACCEPTANCE_PATH=/invitations/accept
# Generate independently with: openssl rand -base64 32 | tr -d '\n'
OWNER_INVITATION_TOKEN_HMAC_SECRET=replace-with-independent-canonical-base64-32-byte-key
# Generate independently with: openssl rand -base64 32 | tr -d '\n'
OWNER_INVITATION_ENCRYPTION_KEYRING=local-v1=replace-with-independent-canonical-base64-32-byte-key
OWNER_INVITATION_ENCRYPTION_ACTIVE_KEY_ID=local-v1
OWNER_INVITATION_EXPIRY_SECONDS=86400
OWNER_INVITATION_DELIVERY_LEASE_SECONDS=60
OWNER_INVITATION_DELIVERY_MAX_ATTEMPTS=3
OWNER_INVITATION_DELIVERY_CONCURRENCY=1
# Managed workers need a unique stable deployment identity; the local script supplies its own value.
OWNER_INVITATION_WORKER_ID=local-owner-invitation-worker

# Run-once member reminder reservation. Keep disabled until test/dev outbox grants are reviewed.
# A separate operator schedule invokes the CLI; this switch never starts a timer in the API.
MEMBER_REMINDER_SCHEDULER_ENABLED=false

# Separate run-once Resend sender; keep disabled until a verified notify domain and runtime grants exist.
# The sender must be a bare reminders@notify.<domain> address, not a display-name string.
MEMBER_REMINDER_DELIVERY_ENABLED=false
MEMBER_REMINDER_FROM_EMAIL=reminders@notify.example.invalid

# The delivery-status reconciler uses .env.reminder-reconciler.local, not this API environment.
# Its separate example is .env.reminder-reconciler.local.example.

# Disposable PostgreSQL bootstrap-test settings belong only in .env.bootstrap-test.local.
