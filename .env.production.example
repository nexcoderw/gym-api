# Production API process and exact non-tenant browser origins.
# Tenant portals are validated separately against ORGANIZATION_PORTAL_BASE_DOMAIN.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
CORS_ORIGINS=https://admin.example.com
SWAGGER_ENABLED=false

# Global API rate limiting. Tune from observed production traffic and abuse metrics.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100

# Production runtime database. Inject a restricted runtime credential from the secret manager.
DATABASE_URL="postgresql://gym_app:provided-by-secret-manager@database.example.invalid:5432/gym_prod?sslmode=verify-full"
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000

# Platform administrator session and login policy. The origin must match the deployed admin app.
PLATFORM_ADMIN_ORIGIN=https://admin.example.com
PLATFORM_AUTH_COOKIE_SECURE=true
# Generate once in a protected environment: node --input-type=module -e "import argon2 from 'argon2'; console.log(await argon2.hash(crypto.randomUUID()))"
PLATFORM_AUTH_DUMMY_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=1$provided-by-secret-manager$provided-by-secret-manager'
# Generate with: openssl rand -base64 32 | tr -d '\n'
PLATFORM_AUTH_TOKEN_PEPPER=provided-by-secret-manager
PLATFORM_AUTH_SESSION_TTL_SECONDS=28800
PLATFORM_AUTH_IDLE_TTL_SECONDS=1800
PLATFORM_AUTH_LOGIN_ATTEMPT_WINDOW_MS=900000
PLATFORM_AUTH_LOGIN_ATTEMPT_LIMIT=5
PLATFORM_AUTH_SINGLE_INSTANCE=true

# Platform MFA policy and independently generated TOTP encryption keyring.
PLATFORM_AUTH_MFA_CHALLENGE_TTL_SECONDS=300
PLATFORM_AUTH_MFA_MAX_ATTEMPTS=5
PLATFORM_AUTH_EMAIL_OTP_ENABLED=false
# Generate with: openssl rand -base64 32 | tr -d '\n'
PLATFORM_TOTP_KEYRING=production-v1=provided-by-secret-manager
PLATFORM_TOTP_ACTIVE_KEY_ID=production-v1

# Resend transactional email. Create a domain-restricted key in Resend and inject it securely.
# The current API uses this one verified sender for MFA and owner invitations.
RESEND_API_KEY=re_provided_by_secret_manager
RESEND_FROM_EMAIL=onboarding@notify.example.invalid

# Production tenant portals use https://<organization-slug>.<base-domain>.
# Configure a DNS base domain only; never enter a wildcard or URL here.
ORGANIZATION_PORTAL_BASE_DOMAIN=example.com
OWNER_AUTH_COOKIE_SECURE=true
# Generate each value independently with: openssl rand -base64 32 | tr -d '\n'
OWNER_AUTH_TOKEN_PEPPER=provided-by-secret-manager
OWNER_ENROLLMENT_TOKEN_PEPPER=provided-by-secret-manager-with-a-different-key
OWNER_AUTH_SESSION_TTL_SECONDS=28800
OWNER_AUTH_IDLE_TTL_SECONDS=1800
OWNER_AUTH_LOGIN_ATTEMPT_WINDOW_MS=900000
OWNER_AUTH_LOGIN_ATTEMPT_LIMIT=5
OWNER_ENROLLMENT_CHALLENGE_TTL_SECONDS=600

# Interactive platform-owner bootstrap is configured separately and disabled in the API process.
PLATFORM_OWNER_BOOTSTRAP_ENABLED=false

# Owner invitation delivery gates, public acceptance URL, independent cryptography and worker limits.
# Keep both gates false until the migration, grants, sender and acceptance page pass release review.
OWNER_INVITATION_DELIVERY_ENABLED=false
OWNER_INVITATION_DELIVERY_DATABASE_APPROVED=false
# Generate with: uuidgen | tr '[:upper:]' '[:lower:]'
OWNER_INVITATION_ACCEPTANCE_REVIEW_ID=00000000-0000-4000-8000-000000000000
OWNER_INVITATION_ACCEPTANCE_PATH=/invitations/accept
# Generate independently with: openssl rand -base64 32 | tr -d '\n'
OWNER_INVITATION_TOKEN_HMAC_SECRET=provided-by-secret-manager
# Generate independently with: openssl rand -base64 32 | tr -d '\n'
OWNER_INVITATION_ENCRYPTION_KEYRING=production-v1=provided-by-secret-manager
OWNER_INVITATION_ENCRYPTION_ACTIVE_KEY_ID=production-v1
OWNER_INVITATION_EXPIRY_SECONDS=86400
OWNER_INVITATION_DELIVERY_LEASE_SECONDS=60
OWNER_INVITATION_DELIVERY_MAX_ATTEMPTS=3
OWNER_INVITATION_DELIVERY_CONCURRENCY=1
OWNER_INVITATION_WORKER_ID=owner-invitations-production-1

# Run-once member reminder reservation. Enable only after the outbox migration and runtime grants.
# A separate managed schedule invokes the CLI; this switch never starts a timer in the API.
MEMBER_REMINDER_SCHEDULER_ENABLED=false
