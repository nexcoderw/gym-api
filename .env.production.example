NODE_ENV=production
HOST=0.0.0.0
PORT=3000
CORS_ORIGINS=https://gym.rw,https://admin.gym.rw,https://portal.gym.rw
SWAGGER_ENABLED=false
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100
DATABASE_URL=postgresql://gym_app:provided-by-secret-manager@database.example:5432/gym_prod?sslmode=verify-full
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
PLATFORM_ADMIN_ORIGIN=https://admin.gym.rw
PLATFORM_AUTH_COOKIE_SECURE=true
PLATFORM_AUTH_DUMMY_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=1$provided-by-secret-manager$provided-by-secret-manager'
PLATFORM_AUTH_TOKEN_PEPPER=provided-by-secret-manager
PLATFORM_AUTH_SESSION_TTL_SECONDS=28800
PLATFORM_AUTH_IDLE_TTL_SECONDS=1800
PLATFORM_AUTH_MFA_CHALLENGE_TTL_SECONDS=300
PLATFORM_AUTH_MFA_MAX_ATTEMPTS=5
PLATFORM_AUTH_LOGIN_ATTEMPT_WINDOW_MS=900000
PLATFORM_AUTH_LOGIN_ATTEMPT_LIMIT=5
PLATFORM_AUTH_SINGLE_INSTANCE=true
PLATFORM_TOTP_KEYRING=key-identifier=provided-by-secret-manager
PLATFORM_TOTP_ACTIVE_KEY_ID=key-identifier
ORGANIZATION_PORTAL_ORIGIN=https://portal.gym.rw
OWNER_AUTH_COOKIE_SECURE=true
OWNER_AUTH_TOKEN_PEPPER=provided-by-secret-manager
OWNER_ENROLLMENT_TOKEN_PEPPER=provided-by-secret-manager-with-a-different-key
OWNER_AUTH_SESSION_TTL_SECONDS=28800
OWNER_AUTH_IDLE_TTL_SECONDS=1800
OWNER_ENROLLMENT_CHALLENGE_TTL_SECONDS=600
OWNER_AUTH_LOGIN_ATTEMPT_WINDOW_MS=900000
OWNER_AUTH_LOGIN_ATTEMPT_LIMIT=5
PLATFORM_OWNER_BOOTSTRAP_ENABLED=false
# Disabled until independently reviewed migration, role grants and actual acceptance destination.
OWNER_INVITATION_DELIVERY_ENABLED=false
OWNER_INVITATION_DELIVERY_DATABASE_APPROVED=false
OWNER_INVITATION_ACCEPTANCE_REVIEW_ID=
OWNER_INVITATION_ACCEPTANCE_ORIGIN=
OWNER_INVITATION_ACCEPTANCE_PATH=/invitations/accept
OWNER_INVITATION_TOKEN_HMAC_SECRET=
OWNER_INVITATION_ENCRYPTION_KEYRING=
OWNER_INVITATION_ENCRYPTION_ACTIVE_KEY_ID=
OWNER_INVITATION_EXPIRY_SECONDS=86400
OWNER_INVITATION_DELIVERY_LEASE_SECONDS=60
OWNER_INVITATION_DELIVERY_MAX_ATTEMPTS=3
OWNER_INVITATION_DELIVERY_CONCURRENCY=1
OWNER_INVITATION_WORKER_ID=
RESEND_API_KEY=
# Separately verified notify.gym.rw sender; never a client-selected address.
RESEND_FROM_EMAIL=
# Operator bootstrap settings are supplied separately, only to the interactive CLI.
