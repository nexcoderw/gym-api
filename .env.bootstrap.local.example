# Interactive operator bootstrap gate. Shared authentication settings come from .env.local.
# Leave disabled until the target identity and database marker are independently verified.
PLATFORM_OWNER_BOOTSTRAP_ENABLED=false

# Restricted bootstrap connection to the same development database used by the local API.
DATABASE_URL="postgresql://gym_bootstrap:replace-with-local-password@localhost:5432/gym_dev?sslmode=verify-full"

# Fail-closed target assertions for the interactive bootstrap command.
PLATFORM_OWNER_BOOTSTRAP_EXPECTED_DATABASE_HOST=localhost
PLATFORM_OWNER_BOOTSTRAP_EXPECTED_DATABASE_NAME=gym_dev
PLATFORM_OWNER_BOOTSTRAP_EXPECTED_DATABASE_ROLE=gym_bootstrap
# Generate the marker UUID with: uuidgen | tr '[:upper:]' '[:lower:]'
PLATFORM_OWNER_BOOTSTRAP_EXPECTED_DATABASE_MARKER=nexcode-gym:bootstrap:00000000-0000-4000-8000-000000000000
