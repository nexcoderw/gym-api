 # Local interactive operator CLI only. Shared authentication settings come from .env.local.
# Leave disabled until the role, database marker, and target have been independently verified.
PLATFORM_OWNER_BOOTSTRAP_ENABLED=false
# Same development branch and database as runtime; a different restricted role.
DATABASE_URL="postgresql://gym_bootstrap:replace-me@localhost:5432/gym_dev?sslmode=verify-full"
PLATFORM_OWNER_BOOTSTRAP_EXPECTED_DATABASE_HOST=localhost
PLATFORM_OWNER_BOOTSTRAP_EXPECTED_DATABASE_NAME=gym_dev
PLATFORM_OWNER_BOOTSTRAP_EXPECTED_DATABASE_ROLE=gym_bootstrap
PLATFORM_OWNER_BOOTSTRAP_EXPECTED_DATABASE_MARKER=nexcode-gym:bootstrap:replace-with-uuid-v4
