# Isolated production reconciler process only. Supply these via its secret manager.
# Never inject its Resend full-access key into the HTTP API or reminder sender.
NODE_ENV=production

# Restricted gym_app runtime connection with TLS; never use migration credentials.
DATABASE_URL="postgresql://gym_app:provided-by-secret-manager@database.example.invalid:5432/gym_prod?sslmode=verify-full"
DATABASE_POOL_MAX=2
DATABASE_CONNECTION_TIMEOUT_MS=10000

# Run once from a managed schedule after the sender. No built-in timer is started.
MEMBER_REMINDER_SCHEDULER_ENABLED=true
MEMBER_REMINDER_RECONCILIATION_ENABLED=true
MEMBER_REMINDER_FROM_EMAIL=reminders@notify.mucyora.rw

# Dedicated full-access Resend key: GET /emails does not support sending-only keys.
# Rotate independently and never reuse RESEND_API_KEY from the sender process.
RESEND_REMINDER_RECONCILER_API_KEY=re_provided_by_secret_manager
